{
  "name": "worldstage-3d",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "audio:prepare": "node scripts/prepare-orchestra.mjs",
    "predev": "node scripts/check-audio.mjs",
    "prebuild": "node scripts/check-audio.mjs",
    "prebuild:public": "node scripts/check-audio.mjs",
    "start": "node server.js",
    "start:env": "node --env-file=.env server.js",
    "dev": "vite --host 127.0.0.1 --port 5196",
    "build": "vite build",
    "build:public": "vite build --mode public",
    "textures": "node scripts/generate-skins.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5196",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@fontsource/manrope": "5.2.8",
    "@phosphor-icons/core": "2.1.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "vite": "6.4.6"
  }
}
