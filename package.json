{
  "name": "worldstage-3d",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "audio:prepare": "node scripts/prepare-orchestra.mjs && node scripts/prepare-voices.js && node scripts/prepare-gate-voice.mjs",
    "audio:voices": "node scripts/prepare-voices.js",
    "audio:gate": "node scripts/prepare-gate-voice.mjs",
    "predev": "node scripts/check-audio.mjs",
    "prebuild": "node scripts/check-audio.mjs",
    "prebuild:public": "node scripts/check-audio.mjs",
    "start": "node server.js",
    "start:env": "node --env-file=.env server.js",
    "dev": "vite --host 127.0.0.1 --port 5196",
    "build": "vite build",
    "build:public": "vite build --mode public",
    "build:vercel": "npm run build:public && node scripts/prepare-public-output.mjs",
    "textures": "node scripts/generate-skins.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5196",
    "preview:phone": "node scripts/phone-preview.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@fontsource/manrope": "5.2.8",
    "@phosphor-icons/core": "2.1.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "vite": "6.4.6"
  }
}
